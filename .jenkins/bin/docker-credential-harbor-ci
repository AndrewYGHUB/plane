#!/usr/bin/env python3
"""Read-only Docker credential helper for the mounted Jenkins Harbor Secret.

The Docker config contains only the helper name. Credential bytes are read only
for a `get` request and are returned to the requesting process over stdout, as
required by the Docker credential-helper protocol.
"""

from __future__ import annotations

import json
import os
from pathlib import Path
import sys


ALLOWED_SERVERS = {
    "harbor.yunxilu.com",
    "https://harbor.yunxilu.com",
    "https://harbor.yunxilu.com/v1/",
}
USERNAME_FILE = Path(
    os.environ.get(
        "HARBOR_USERNAME_FILE",
        "/var/run/secrets/cloudhandstack/harbor-ci/username",
    )
)
PASSWORD_FILE = Path(
    os.environ.get(
        "HARBOR_PASSWORD_FILE",
        "/var/run/secrets/cloudhandstack/harbor-ci/password",
    )
)


def fail(message: str) -> "NoReturn":
    print(f"harbor credential helper: {message}", file=sys.stderr)
    raise SystemExit(1)


def read_secret(path: Path, label: str) -> str:
    try:
        raw = path.read_bytes().rstrip(b"\r\n")
    except OSError:
        fail(f"{label} Secret file is unavailable")
    if not raw or b"\x00" in raw:
        fail(f"{label} Secret file is invalid")
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        fail(f"{label} Secret is not UTF-8")


def main() -> None:
    action = sys.argv[1] if len(sys.argv) == 2 else ""
    if action == "get":
        server = sys.stdin.read().strip()
        if server not in ALLOWED_SERVERS:
            fail("registry is not the approved Harbor host")
        json.dump(
            {
                "ServerURL": "harbor.yunxilu.com",
                "Username": read_secret(USERNAME_FILE, "username"),
                "Secret": read_secret(PASSWORD_FILE, "password"),
            },
            sys.stdout,
            separators=(",", ":"),
        )
        sys.stdout.write("\n")
        return
    if action == "list":
        sys.stdout.write("{}\n")
        return
    if action in {"store", "erase"}:
        fail("helper is read-only")
    fail("expected get, list, store, or erase")


if __name__ == "__main__":
    main()
